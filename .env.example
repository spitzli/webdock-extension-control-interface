# Host-generated runtime authority; never commit real values.
WEBDOCK_PLUGIN_RUNTIME_TOKEN=
WEBDOCK_PLUGIN_HOST_URL=https://api.webdock.dev
WEBDOCK_PLUGIN_CONSOLE_ORIGIN=https://console.webdock.dev
WEBDOCK_PLUGIN_HOST_PUBLIC_KEY_FILE=/run/secrets/host-public.pem
WEBDOCK_PLUGIN_GENERATION=1
WEBDOCK_PLUGIN_PROJECT_ID=
WEBDOCK_PLUGIN_TLS_CERT=/run/tls/cert.pem
WEBDOCK_PLUGIN_TLS_KEY=/run/tls/key.pem
# Operator-mounted API token for precisely this installation/project.
LUMASERV_API_TOKEN_FILE=/run/secrets/lumaserv-api-token
